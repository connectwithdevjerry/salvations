# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit a file containing real values.
# In production these are set as Vercel encrypted environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas — the primary database.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=<app>
# The database name is required; do not rely on the driver default.
MONGODB_URI=
MONGODB_DB_NAME=salvations

# Authentication — ours, not a vendor's.
# Signs session access tokens. Rotating it signs everyone out.
AUTH_JWT_SECRET=

# Sign in with Google (optional).
# Set BOTH or NEITHER — one without the other offers a button that cannot
# complete, and the app refuses to start that way.
# From console.cloud.google.com → APIs & Services → Credentials → OAuth client
# (Web application). Authorised redirect URI must be exactly:
#   <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: a second OAuth client, in a separate Google Cloud project, used
# only for the Google Workspace integration (Gmail, Calendar, Drive). Google
# verifies a whole project, and one that asks for Gmail faces a long review
# that a sign-in-only project does not. With these set, sign-in can be
# published at once while Workspace stays in testing with named test users.
# Redirect URI for this client: <PUBLIC_BASE_URL>/api/mcp/callback
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Outgoing mail, for email verification codes. Your own mail server, spoken
# to directly over SMTP. For Google Workspace or Gmail use an app password:
#   SMTP_URL=smtps://you@yourdomain.com:app-password@smtp.gmail.com:465
# Leave both empty and no mail is sent; the app says so where a code is offered.
SMTP_URL=
MAIL_FROM=

# Web search for the assistants, through Google's Programmable Search with
# your own key. Make a search engine at programmablesearchengine.google.com
# (search the entire web), then an API key in Google Cloud with the Custom
# Search API enabled. Without both, assistants can read a page they are
# given an address for but cannot search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Credential envelope encryption — base64 32-byte key.
# Generate with: openssl rand -base64 32
# KEEP A COPY OUTSIDE THE HOST. Every stored credential is encrypted under it;
# lose it and none of them can be recovered. That is by design.
CREDENTIAL_KEK=

# HMAC secret for /api/internal/* (execute, sweep). Must not equal any other secret.
INTERNAL_HMAC_SECRET=

# Public origin — used for the CIMD client_id document and OAuth redirect URIs
PUBLIC_BASE_URL=http://localhost:3000

# ── Not read by any code yet; listed so the intent is on record. ──
# Blob storage for spilled tool results (Phase 1 tail)
BLOB_READ_WRITE_TOKEN=
# OpenTelemetry export (§1.10)
OTEL_EXPORTER_OTLP_ENDPOINT=
