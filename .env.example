# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. NEVER commit a file containing real values.
# In production these are set as Vercel encrypted environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas — the primary database.
# Format: mongodb+srv://<user>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority&appName=<app>
# The database name is required; do not rely on the driver default.
MONGODB_URI=
MONGODB_DB_NAME=salvations

# Authentication — ours, not a vendor's.
# Signs session access tokens. Rotating it signs everyone out.
AUTH_JWT_SECRET=

# Sign in with Google (optional).
# Set BOTH or NEITHER — one without the other offers a button that cannot
# complete, and the app refuses to start that way.
# From console.cloud.google.com → APIs & Services → Credentials → OAuth client
# (Web application). Authorised redirect URI must be exactly:
#   <PUBLIC_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: a second OAuth client, in a separate Google Cloud project, used
# only for the Google Workspace integration (Gmail, Calendar, Drive). Google
# verifies a whole project, and one that asks for Gmail faces a long review
# that a sign-in-only project does not. With these set, sign-in can be
# published at once while Workspace stays in testing with named test users.
# Redirect URI for this client: <PUBLIC_BASE_URL>/api/mcp/callback
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# Optional: the Meta app behind the Instagram & Facebook integration (posting
# to Facebook pages and Instagram professional accounts). Set BOTH or NEITHER.
# From developers.facebook.com → your app → App settings → Basic. The app needs
# the Facebook Login for Business and Instagram products, and this URI among
# its valid OAuth redirect URIs:
#   <PUBLIC_BASE_URL>/api/mcp/callback
# While the app is in development mode only its admins, developers and testers
# can connect; publishing to anyone else's pages needs App Review for the
# permissions listed in the catalogue.
META_APP_ID=
META_APP_SECRET=
# WhatsApp in one press (Meta's Embedded Signup) on the same Meta app. Optional.
# In the app: add the WhatsApp product; under Facebook Login for Business →
# Configurations create one with the WhatsApp Embedded Signup login variation
# and copy its Configuration ID; add the YASHAYAH domain to Allowed Domains and
# <PUBLIC_BASE_URL>/ to Valid OAuth Redirect URIs; under WhatsApp →
# Configuration set the webhook callback URL to
# <PUBLIC_BASE_URL>/api/channels/whatsapp/app with the verify token below,
# and subscribe to the messages field. While the app is in development mode
# only its admins and testers can connect; onboarding other businesses needs
# App Review for whatsapp_business_management and whatsapp_business_messaging
# (Tech Provider). Customers add their own payment method to their account.
META_WHATSAPP_CONFIG_ID=
# Any string of 8+ characters, typed into the Meta app beside the callback URL.
META_WHATSAPP_VERIFY_TOKEN=

# Optional: the LinkedIn app behind the LinkedIn integration (posting as the
# person, or as a company page they administer). Set BOTH or NEITHER. From
# developer.linkedin.com → your app → Auth. Add the products "Share on
# LinkedIn" and "Sign In with LinkedIn using OpenID Connect"; for page posts,
# "Community Management API" and then LINKEDIN_SCOPES with the page scopes,
# e.g. "openid profile w_member_social r_organization_admin w_organization_social".
# Redirect URL: <PUBLIC_BASE_URL>/api/mcp/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# "Connect Telegram": one bot, made once with BotFather, that every workspace
# talks to. Optional; the person's own bot stays the long way. YASHAYAH points the
# bot's webhook at <PUBLIC_BASE_URL>/api/channels/telegram/app the first time
# anyone presses the button. Also settable from the admin dashboard.
TELEGRAM_BOT_TOKEN=

# "Add to Slack": one Slack app owned by this deployment that any Slack
# workspace installs from a button, instead of each person making an app and
# pasting its token. Set all THREE or NONE. Without them Slack is still offered
# the long way. From api.slack.com/apps, create the app, then:
#   Basic Information → App Credentials: Client ID, Client Secret, Signing Secret
#   OAuth & Permissions → Redirect URLs: <PUBLIC_BASE_URL>/api/channels/slack/callback
#   OAuth & Permissions → Bot Token Scopes: chat:write, im:history,
#     app_mentions:read, files:read, files:write
#   Event Subscriptions → on, Request URL <PUBLIC_BASE_URL>/api/channels/slack/app
#     (save it after the deployment is live; Slack checks it), then subscribe
#     to the bot events message.im and app_mention
#   Interactivity & Shortcuts → on, the same Request URL
#   App Home → Show Tabs → Messages Tab on, and allow users to send messages
#   Manage Distribution → activate public distribution, so other workspaces
#     can install it (no Slack review is needed for that; only a Marketplace
#     listing is reviewed)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# "Add to Discord": one Discord application owned by this deployment that any
# server adds from a button. Set all FOUR or NONE. Without them Discord is still
# offered the long way. From discord.com/developers/applications, create the
# application, then:
#   General Information: Application ID and Public Key; set Interactions
#     Endpoint URL to <PUBLIC_BASE_URL>/api/channels/discord/app (Discord pings
#     it before saving, so the deployment must be live with these set)
#   OAuth2: Client Secret; add redirect <PUBLIC_BASE_URL>/api/channels/discord/callback
#   Bot: Reset Token and copy it; leave Public Bot on so other servers can add it
#   Installation: Guild Install on (User Install is not used)
# The /yashayah command is created on the application the first time a server is
# added. A DM with the bot names no server, so /yashayah works in servers only.
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
LINKEDIN_SCOPES=

# Outgoing mail, for email verification codes. Your own mail server, spoken
# to directly over SMTP. For Google Workspace or Gmail use an app password:
#   SMTP_URL=smtps://you@yourdomain.com:app-password@smtp.gmail.com:465
# Leave both empty and no mail is sent; the app says so where a code is offered.
SMTP_URL=
MAIL_FROM=

# Web search for the assistants, through Google's Programmable Search with
# your own key. Make a search engine at programmablesearchengine.google.com
# (search the entire web), then an API key in Google Cloud with the Custom
# Search API enabled. Without both, assistants can read a page they are
# given an address for but cannot search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Who may change the deployment's own keys from the admin dashboard (the Slack,
# Discord and Meta apps, Yashayah's key, the LinkedIn and Google Workspace
# clients). Comma-separated email addresses of signed-in accounts. A value set
# on the dashboard wins over the matching variable below and takes effect
# within a minute, no redeploy; the variables stay as the fallback.
PLATFORM_ADMIN_EMAILS=

# Yashayah: a model that comes with the subscription, on a key this deployment
# holds. Optional. With a key set, every workspace gets a provider called
# Yashayah bound to the usual roles; assistants think with it until the person
# connects a key of their own. The deployment pays the vendor, and the cap is
# what one workspace may spend of this key in a month (dollars). The vendor is
# any the registry knows (openai or anthropic; openai by default), the chat
# model a catalogue id for it (the vendor's default when unset). The key is
# never written to a workspace.
PLATFORM_AI_API_KEY=
PLATFORM_AI_PROVIDER=openai
PLATFORM_AI_CHAT_MODEL=
PLATFORM_AI_MONTHLY_USD_CAP=25

# The OpenAI key the voice console on the landing page runs on: OpenAI hears
# the visitor and Bee answers, a few questions per visitor an hour and a few
# hundred for the site a day. Also settable on the admin dashboard under
# Deployment settings -> Landing page voice. Empty uses PLATFORM_AI_API_KEY
# when Yashayah runs on OpenAI; with neither, the console gives scripted
# answers in the browser.
LANDING_VOICE_OPENAI_KEY=
# The live call: OpenAI's Realtime model (speech to speech) and its voice.
# Empty means gpt-realtime and marin. If OpenAI refuses the model, the
# console falls back to hearing, then answering.
LANDING_VOICE_REALTIME_MODEL=
LANDING_VOICE_VOICE=

# OAuth clients registered by hand with vendors whose MCP servers accept
# neither a client metadata document nor dynamic registration (Asana,
# HubSpot). JSON keyed by the vendor's domain. Create the app in the
# vendor's developer console with <PUBLIC_BASE_URL>/api/mcp/callback as
# the redirect URI. Without an entry, that vendor is not offered.
# MCP_OAUTH_CLIENTS={"asana.com":{"client_id":"","client_secret":""},"hubspot.com":{"client_id":"","client_secret":""}}
MCP_OAUTH_CLIENTS=

# Credential envelope encryption — base64 32-byte key.
# Generate with: openssl rand -base64 32
# KEEP A COPY OUTSIDE THE HOST. Every stored credential is encrypted under it;
# lose it and none of them can be recovered. That is by design.
CREDENTIAL_KEK=

# HMAC secret for /api/internal/* (execute, sweep). Must not equal any other secret.
INTERNAL_HMAC_SECRET=

# Public origin — used for the CIMD client_id document and OAuth redirect URIs
PUBLIC_BASE_URL=http://localhost:3000

# Traces: run → step → model call | tool call, as OTLP/HTTP to any
# OpenTelemetry collector. Headers are comma-separated key=value pairs.
# Without an endpoint, spans are collected per run and dropped.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=hive

# Billing. All three or none: a secret key without a webhook secret takes
# payments and never hears that they succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Workspace ids never asked to pay (yours, a partner's), comma-separated.
# Everyone else starts a 10-day free trial or subscribes before running an
# assistant.
COMPLIMENTARY_WORKSPACES=

# ── Not read by any code yet; listed so the intent is on record. ──
# Blob storage for spilled tool results (Phase 1 tail)
BLOB_READ_WRITE_TOKEN=
